# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Gateway (provisioned via `vercel env pull`)
# VERCEL_OIDC_TOKEN is auto-provisioned

# Twilio WhatsApp sandbox (see docs/whatsapp-demo-setup.md)
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_DEMO_TENANT_SLUG=salon-maria
# Set to "false" only for local debugging without Twilio signatures
# WHATSAPP_VALIDATE_SIGNATURE=false

# Resend email (see docs/whatsapp-demo-setup.md)
RESEND_API_KEY=re_your_resend_api_key
RESEND_OPERATOR_CC=reggieebryant@gmail.com
# Override only after verifying a domain with Resend
# RESEND_FROM=MiNegocio <hola@minegocio.app>
