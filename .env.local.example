# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Gateway (provisioned via `vercel env pull`)
# VERCEL_OIDC_TOKEN is auto-provisioned

# WhatsApp transport — Kapso (see docs/kapso-setup.md)
KAPSO_API_KEY=kp_live_your_kapso_api_key
KAPSO_PHONE_NUMBER_ID=your_kapso_phone_number_id
KAPSO_WEBHOOK_SECRET=your_kapso_webhook_secret
WHATSAPP_DEMO_TENANT_SLUG=salon-maria
# Debug-only — never set to "false" in production
# KAPSO_VALIDATE_SIGNATURE=false

# Resend email (see docs/whatsapp-demo-setup.md)
RESEND_API_KEY=re_your_resend_api_key
RESEND_OPERATOR_CC=reggieebryant@gmail.com
# Override only after verifying a domain with Resend
# RESEND_FROM=MiNegocio <hola@minegocio.app>

# Google Calendar (see docs/calendar-setup.md)
# Base64-encoded service-account JSON key. The plain JSON also works but
# multi-line values are fragile in Vercel's env storage.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Calendar to write events to. For primary personal calendars this is
# just the gmail address.
GOOGLE_CALENDAR_ID=reggieebryant@gmail.com
# Optional: "none" (default), "all", "externalOnly". Default avoids
# double-emailing attendees since we send our own branded confirmation.
# GOOGLE_CALENDAR_SEND_UPDATES=none
